<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fond</item>
        <item name="colorPrimaryDark">@color/fond</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Le fond reste celui du site pendant qu'il charge : sans lui, la WebView
         montrait un écran blanc entre le démarrage et la première page. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/fond</item>
    </style>

    <!-- Écran de démarrage : la Cavale violette de l'accueil sur le fond du
         site (image produite par mobile/scripts/icones.mjs). Ouverture.java
         l'enchaîne avec l'animation d'ouverture. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fond</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_cavale</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
