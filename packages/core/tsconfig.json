{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Pas de `rootDir` : les tests vivent à côté de `src`, et `noEmit` rend
    // la contrainte inutile — elle ne servait qu'à cadrer une sortie qu'on
    // ne produit pas.
    "outDir": "./dist",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
