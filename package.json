{
  "name": "coupparfait",
  "version": "0.1.0",
  "private": true,
  "description": "Le Coup Parfait — plateforme d'échecs libre : apprendre, jouer, progresser. 100% gratuite et auto-hébergeable.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @coupparfait/web",
    "dev:server": "npm run dev -w @coupparfait/server",
    "build": "npm run build -w @coupparfait/web",
    "start:web": "npm run start -w @coupparfait/web",
    "start:server": "npm run start -w @coupparfait/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @coupparfait/core && node --experimental-strip-types scripts/check-lessons.mjs && node --experimental-strip-types scripts/check-eboards.mjs && node --experimental-strip-types scripts/check-elo.mjs && node --experimental-strip-types scripts/check-outils-elo.mjs && node --experimental-strip-types scripts/check-carriere.mjs && node --experimental-strip-types scripts/check-tournoi.mjs && node --experimental-strip-types scripts/check-cadences.mjs && node --experimental-strip-types scripts/check-glossaire.mjs && node --experimental-strip-types scripts/check-enjeux.mjs && node --experimental-strip-types scripts/check-seances.mjs && node --experimental-strip-types scripts/check-langues.mjs && node --experimental-strip-types scripts/check-cles-coeur.mjs && node --experimental-strip-types scripts/check-credits.mjs && node --experimental-strip-types scripts/check-partie-terminee.mjs && npm test -w @coupparfait/server",
    "test:realtime": "node scripts/smoke-realtime.mjs --serveur",
    "db:push": "npm run db:push -w @coupparfait/db",
    "install:maia": "node scripts/install-maia.mjs",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.mjs",
    "etalonner:conversion": "node --experimental-strip-types --env-file=.env scripts/etalonner-conversion.mjs",
    "seed:demo:purge": "node --experimental-strip-types scripts/seed-demo.mjs --purge",
    "db:generate": "npm run db:generate -w @coupparfait/db",
    "db:migrate": "npm run db:migrate -w @coupparfait/db",
    "db:studio": "npm run db:studio -w @coupparfait/db",
    "data:assets": "node scripts/fetch-assets.mjs",
    "data:drapeaux": "node --experimental-strip-types scripts/fetch-drapeaux.mjs",
    "data:engine": "node scripts/setup-engine.mjs",
    "data:openings:build": "node scripts/build-openings.mjs",
    "data:openings": "node scripts/import-openings.mjs",
    "data:puzzles": "node scripts/import-puzzles.mjs",
    "icons": "node scripts/build-icons.mjs",
    "vapid": "node scripts/vapid.mjs",
    "brand:cavale": "node scripts/build-cavale.mjs",
    "check:lessons": "node --experimental-strip-types scripts/check-lessons.mjs",
    "check:glossaire": "node --experimental-strip-types scripts/check-glossaire.mjs",
    "check:enjeux": "node --experimental-strip-types scripts/check-enjeux.mjs",
    "check:seances": "node --experimental-strip-types scripts/check-seances.mjs",
    "check:langues": "node --experimental-strip-types scripts/check-langues.mjs",
    "check:cles-coeur": "node --experimental-strip-types scripts/check-cles-coeur.mjs",
    "check:textes": "node scripts/check-textes-durs.mjs",
    "check:eboards": "node --experimental-strip-types scripts/check-eboards.mjs",
    "check:puzzles": "node scripts/check-puzzles.mjs",
    "check:cadences": "node --experimental-strip-types scripts/check-cadences.mjs",
    "check:credits": "node --experimental-strip-types scripts/check-credits.mjs",
    "data:endgames": "node scripts/build-endgames.mjs",
    "data:opening-stats": "node scripts/build-opening-stats.mjs",
    "data:evals": "node scripts/import-evals.mjs",
    "voice:install": "node scripts/install-piper.mjs",
    "engine:install": "node scripts/install-stockfish.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:images": "node scripts/build-brand.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
