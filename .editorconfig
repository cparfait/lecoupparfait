# Les réglages que le code suit déjà, écrits une fois pour que l'éditeur les
# applique sans qu'on ait à y penser.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne font un retour à la ligne en Markdown.
trim_trailing_whitespace = false
