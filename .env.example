# ─────────────────────────────────────────────────────────────

#  Le Coup Parfait — configuration

#  Copie ce fichier en `.env` puis adapte les valeurs.

# ─────────────────────────────────────────────────────────────



# ── Base de données ──────────────────────────────────────────

POSTGRES_USER=coupparfait

POSTGRES_PASSWORD=change-moi-en-production

POSTGRES_DB=coupparfait

# En Docker, `docker-compose.yml` impose sa propre valeur : les conteneurs
# joignent la base par le nom de service `db`, sur le réseau interne, et aucun
# port n'est publié sur l'hôte. Cette ligne ne sert qu'au développement, où
# PostgreSQL tourne en local.
DATABASE_URL=postgresql://coupparfait:change-moi-en-production@localhost:5432/coupparfait



# ── Sécurité ─────────────────────────────────────────────────

# Génère une valeur avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

AUTH_SECRET=remplace-par-une-chaine-aleatoire-de-64-caracteres-minimum

# Durée de session (jours)

AUTH_SESSION_DAYS=30



# ── URLs publiques ───────────────────────────────────────────

# URL depuis le navigateur (mets ton domaine derrière Nginx Proxy Manager)

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# URL interne (conteneur → conteneur) utilisée par le rendu serveur

# INTERNAL_SERVER_URL=http://server:3001  (défini par docker compose)



# ── Serveur temps réel + moteur ──────────────────────────────

SERVER_PORT=3001

WEB_PORT=3000

# Chemin du binaire Stockfish natif dans le conteneur serveur

# Chemin du binaire dans l’image Docker : défini par docker compose,
# et détecté tout seul en local après `npm run engine:install`.
# STOCKFISH_PATH=/usr/local/bin/stockfish

# Nombre de processus Stockfish gardés chauds dans le pool

ENGINE_POOL_SIZE=2

# Threads par processus Stockfish (≤ vCPU disponibles)

ENGINE_THREADS=2

# Table de hachage par processus, en Mo

ENGINE_HASH_MB=256

# Profondeur par défaut de l'analyse serveur

ENGINE_DEFAULT_DEPTH=24

# Profondeur maximale autorisée (protège le CPU)

ENGINE_MAX_DEPTH=34



# ── Administration ───────────────────────────────────────────

# Les pseudos qui ouvrent /admin, séparés par des virgules.
#
# Cette liste prime sur la base et ne peut pas en être délogée. C'est
# volontaire : la colonne `users.role` existe mais vaut « player » pour tout le
# monde tant que personne n'a été promu, et sans premier administrateur
# l'interface ne s'ouvre jamais. Surtout, un accès qui dépendrait d'une seule
# ligne en base se perdrait en restaurant une sauvegarde antérieure à la
# promotion — on serait enfermé dehors de son propre serveur.
#
# Les administrateurs suivants se promeuvent depuis /admin, ce qui écrit bien
# la colonne `role`. Laisse cette variable vide pour fermer l'administration.
# ADMIN_USERNAMES=cparfait


# ── Messagerie sortante (facultatif) ─────────────────────────

# Sans SMTP_URL, aucun courriel ne part — et l'application le sait : elle masque
# le lien « Mot de passe oublié ? » et prévient à l'inscription que l'adresse ne
# servira à rien, plutôt que de promettre un message impossible.
#
# En développement, rien à configurer : les messages sont écrits dans
# data/courriels et lisibles sur /dev/courriels.
#
# En production, deux chemins. Le MTA fourni par la pile :
#     docker compose --profile courriel up -d
#     SMTP_URL=smtp://mail:587
# Ou n'importe quel relais existant :
#     SMTP_URL=smtp://utilisateur:motdepasse@hote:587
#
# Procédure complète et enregistrements DNS : docs/courriel.md
# SMTP_URL=smtp://mail:587

# L'expéditeur. Son domaine doit être celui que DKIM signe et que SPF autorise :
# une adresse d'un autre domaine que la clé qui la signe est refusée.
# MAIL_FROM=Le Coup Parfait <ne-pas-repondre@coupparfait.example>

# Domaine signé par le MTA de la pile, et sélecteur DKIM. Le sélecteur entre
# dans le nom de l'enregistrement : `mail` donne mail._domainkey.<domaine>.
# MAIL_DOMAIN=coupparfait.example
# MAIL_HOSTNAME=mail.coupparfait.example
# MAIL_DKIM_SELECTOR=mail

# Vérifier le certificat du relais. À laisser vide pour le MTA de la pile, qui
# vit sur le réseau privé ; à mettre à 1 pour un relais distant.
# SMTP_TLS_STRICT=1


# ── Notifications poussées (facultatif) ──────────────────────

# Sans ces deux clés, aucune notification ne part — et l'application le sait :
# le réglage disparaît des préférences plutôt que de proposer un abonnement qui
# ne servirait à rien.
#
# Génère la paire avec :  npm run vapid
# Elle s'écrit dans .env toute seule. Ne la regénère pas sans raison : un
# abonnement est lié à la clé publique avec laquelle il a été pris, et changer
# de clé rend muets tous les appareils déjà abonnés.
#
# La clé publique n'a délibérément pas le préfixe NEXT_PUBLIC_ : elle n'est
# jamais lue par le code du navigateur, qui la demande à /api/notifications.
# Elle est donc lue au démarrage comme n'importe quelle autre variable — un
# `docker compose up -d` suffit à la poser, sans reconstruire l'image.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Adresse de contact transmise au service de messagerie du navigateur. Elle
# n'est jamais montrée aux joueurs : c'est ce que Google ou Mozilla utilisent
# pour prévenir en cas de problème d'envoi. Par défaut, celle de MAIL_FROM.
# VAPID_SUBJECT=mailto:admin@coupparfait.example

# Heure locale du rappel du défi du jour, sur 24 h. Vide pour ne rien envoyer.
# C'est l'heure du joueur, pas celle du serveur : le fuseau du navigateur est
# enregistré avec l'abonnement.
DEFI_RAPPEL_HEURE=18

# Procédure complète, et ce que le serveur sait des abonnés : docs/notifications.md


# ── Services externes optionnels (gratuits, sans clé) ────────

# Explorateur d'ouvertures Lichess — laisse vide pour désactiver

LICHESS_EXPLORER_URL=https://explorer.lichess.ovh

# Tables de finales Syzygy 7 pièces — laisse vide pour désactiver

LICHESS_TABLEBASE_URL=https://tablebase.lichess.ovh



# ── Import de données ────────────────────────────────────────

# Nombre de puzzles à importer (0 = tous les 6 057 356 — prévoir ~4 Go et 30 min)

PUZZLE_IMPORT_LIMIT=200000

# Popularité minimale d'un puzzle (-100..100), filtre le bruit

PUZZLE_MIN_POPULARITY=60

# ── Voix neuronale du coach (facultatif) ─────────────────────────────────────
#  Piper synthétise une voix française bien plus naturelle que celle du
#  navigateur, localement et hors ligne. En Docker, tout est déjà dans l'image.
#  En développement :  node scripts/install-piper.mjs
#  Sans ces variables, l'application utilise la synthèse du navigateur.
# PIPER_BIN=/opt/piper/piper
# PIPER_VOICES_DIR=/app/voices

# ── Moteur d'analyse (facultatif en développement) ───────────────────────────
#  En Docker, Stockfish est compilé dans l'image et installé dans
#  /usr/local/bin/stockfish. En local :  npm run engine:install
#  Le serveur détecte tout seul data/stockfish/ ; cette variable ne sert qu'à
#  pointer vers un binaire placé ailleurs.
# STOCKFISH_PATH=/usr/local/bin/stockfish
