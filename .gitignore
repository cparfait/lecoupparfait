# dependencies
node_modules/
.pnp/
.pnp.js

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
!.env.example

# moteur (binaires WASM copiés depuis node_modules, ~14 Mo)
apps/web/public/engine/

# jeux de données téléchargés (plusieurs centaines de Mo)
data/downloads/
# Voix neuronale : quelques centaines de mégaoctets de modèles, réinstallables
# par `npm run voice:install`.
data/piper/
# Moteur natif, réinstallable par `npm run engine:install`.
data/stockfish/
# Lc0 et les poids Maia : téléchargés, jamais versionnés.
data/maia/
# Courriels capturés en développement : ils contiennent des adresses.
# Le motif est non ancré : le serveur Next tourne depuis `apps/web`, la
# boîte atterrit donc là et non à la racine.
**/data/courriels/
data/*.csv
data/*.zst
data/*.pgn
data/*.jsonl

# logs & divers
*.log
npm-debug.log*
.DS_Store
Thumbs.db
coverage/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# docker volumes locaux
.docker-data/
# Sauvegardes produites par le service `backup` de la pile Docker. Elles
# contiennent des mots de passe hachés et des adresses e-mail : elles n'ont
# rien à faire dans un dépôt, public ou non.
/backups/

# extrait de diagnostic de la voix, jetable
/essai-voix.wav

# répertoires de travail jetables
.tmp-probe/
scripts/.tmp/

# Essais de la marque : `build-cavale.mjs --cible logo --style tous` y dépose
# les pistes non retenues, pour comparaison. Rien à versionner.
.essais/

# Matériel de travail, jamais du contenu de l'application.
# `zzsccreens` contient des captures de l'interface de chess.com, servant de
# référence pour comparer nos écrans aux leurs. Elles n'ont rien à faire dans
# un dépôt public : ce sont des copies d'écran d'un produit tiers, et elles ne
# décrivent pas ce dépôt.
zzsccreens/
# Aperçu jetable produit par les scripts de marque, jamais référencé nulle part.
/apercu.png
